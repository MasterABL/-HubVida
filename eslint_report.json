/div>\n            <div className=\"border-t border-hub-border pt-4 mt-auto\">\n              <div className=\"inline-block px-3 py-1 bg-slate-500/10 text-hub-muted rounded-lg text-xs font-bold uppercase tracking-wider mb-2 border border-slate-500/20\">\n                20:30+ - Opcional P├│s-Treino / Janta\n              </div>\n              <p className=\"text-sm text-hub-content border-l-2 border-slate-500 pl-3\">\n                N├úo complique. Replique a l├│gica do almo├ºo em menor quantidade, OU repita a \"Op├º├úo 1\" do Caf├® (P├úo com Ovos ou P├úo com Whey) para n├úo dormir de est├┤mago t├úo cheio e prejudicar o sono.\n              </p>\n            </div>\n          </div>\n\n          {/* BLOCO 3: SUPLEMENTA├ç├âO E PR├ë-TREINO T/Q/S */}\n          <div className=\"bg-hub-surface border border-indigo-500/30 rounded-xl p-5 shadow-md flex flex-col justify-between relative overflow-hidden\">\n            <div className=\"absolute top-0 right-0 p-3 opacity-5 pointer-events-none\">\n              <Zap className=\"w-24 h-24\" />\n            </div>\n\n            <div className=\"relative z-10\">\n              <div className=\"inline-block px-3 py-1 bg-indigo-500/10 text-indigo-400 rounded-lg text-xs font-bold uppercase tracking-wider mb-4 border border-indigo-500/20\">\n                Guia de Suplementos & Pr├®-Treino\n              </div>\n              <h3 className=\"text-lg font-bold text-hub-strong mb-4\">A L├│gica da Mente Focada</h3>\n\n              <ul className=\"space-y-3\">\n                <li className=\"bg-hub-hover p-3 rounded-lg border border-slate-700/50\">\n                  <span className=\"font-bold text-indigo-400 block mb-1\">A Regra da Creatina (5g)</span>\n                  <p className=\"text-xs text-hub-content\">Hor├írio livre. O importante ├® tomar todos os dias sem falta. Como o almo├ºo ├® forte, tomar ap├│s o almo├ºo ajuda na absor├º├úo pelos carboidratos da refei├º├úo.</p>\n                </li>\n\n                <li className=\"bg-hub-hover p-3 rounded-lg border border-slate-700/50\">\n                  <span className=\"font-bold text-emerald-400 block mb-1\">Ter/Qui/Sex (A Salva├º├úo R├ípida)</span>\n                  <p className=\"text-xs text-hub-content\">Ir treinar assim que sai do ingl├¬s cria o \"Jejum de Adrenalina\". Se precisar comer pra n├úo ter tontura: Um iogurte no \"Boa\" ou uma (1) Banana madura 30 minutos antes do treino salvar├úo a sua vida e energia.</p>\n                </li>\n\n                <li className=\"bg-hub-hover p-3 rounded-lg border border-slate-700/50\">\n                  <span className=\"font-bold text-sky-400 block mb-1\">Whey Protein</span>\n                  <p className=\"text-xs text-hub-content\">Use primariamente no Caf├® da Manh├ú. Mistur├í-lo somente com ├ügua ajuda a acelerar a digest├úo matinal e bater os macros r├ípido antes de trampar.</p>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  );\n};\n\n/* ├ìcone customizado de Batimento (Activity) */\nfunction ActivityIcon() {\n  return (\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"text-emerald-500\">\n      <polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"></polyline>\n    </svg>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Abimael Balbino\\OneDrive\\Documentos - Gerais\\HubVida\\src\\components\\Producao.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Abimael Balbino\\OneDrive\\Documentos - Gerais\\HubVida\\src\\components\\RadarChart.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDe